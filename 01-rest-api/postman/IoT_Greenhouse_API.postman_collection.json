{
  "info": {
    "name": "IoT Greenhouse API",
    "description": "Сценарий защиты: создать устройство, отправить показания, получить историю, сработать правило, проверить 404 и 422. Запускайте запросы сверху вниз (или Run collection).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "deviceId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "1. Создать устройство",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/devices",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "devices"
          ]
        },
        "description": "",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Temperature Sensor #1\",\n  \"type\": \"temperature\",\n  \"location\": \"Greenhouse, sector 1\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 Created', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('deviceId', pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Список устройств",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/devices",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "devices"
          ]
        },
        "description": ""
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "3. Одно устройство",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/devices/{{deviceId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "devices",
            "{{deviceId}}"
          ]
        },
        "description": ""
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "4. Нормальное показание (24.5 C)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/devices/{{deviceId}}/readings",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "devices",
            "{{deviceId}}",
            "readings"
          ]
        },
        "description": "",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"sensor_type\": \"temperature\",\n  \"value\": 24.5,\n  \"unit\": \"C\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 Created', () => pm.response.to.have.status(201));",
              "pm.test('Без предупреждения', () => pm.expect(pm.response.json().warning).to.eql(null));"
            ]
          }
        }
      ]
    },
    {
      "name": "5. История показаний",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/devices/{{deviceId}}/readings",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "devices",
            "{{deviceId}}",
            "readings"
          ]
        },
        "description": ""
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.test('Есть записи', () => pm.expect(pm.response.json().length).to.be.above(0));"
            ]
          }
        }
      ]
    },
    {
      "name": "6. Опасное показание (32.1 C) -> TURN_ON_FAN",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/devices/{{deviceId}}/readings",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "devices",
            "{{deviceId}}",
            "readings"
          ]
        },
        "description": "",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"sensor_type\": \"temperature\",\n  \"value\": 32.1,\n  \"unit\": \"C\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 Created', () => pm.response.to.have.status(201));",
              "pm.test('Сработало правило', () => pm.expect(pm.response.json().action).to.eql('TURN_ON_FAN'));"
            ]
          }
        }
      ]
    },
    {
      "name": "7. Ошибка валидации: value строкой, нет sensor_type",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/devices/{{deviceId}}/readings",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "devices",
            "{{deviceId}}",
            "readings"
          ]
        },
        "description": "",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"value\": \"hot\",\n  \"unit\": \"C\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('422 Unprocessable', () => pm.response.to.have.status(422));"
            ]
          }
        }
      ]
    },
    {
      "name": "8. Устройство не найдено",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/devices/99999/readings",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "devices",
            "99999",
            "readings"
          ]
        },
        "description": "",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"sensor_type\": \"temperature\",\n  \"value\": 20,\n  \"unit\": \"C\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('404 Not Found', () => pm.response.to.have.status(404));"
            ]
          }
        }
      ]
    }
  ]
}